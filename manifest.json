{
  "manifest_version": 3,
  "name": "My Offset: measure my usage",
  "version": "0.19.0",
  "description": "Counts how much you use AI, video, food delivery, shopping and ride apps, so My Offset can work out your footprint. Counts only.",
  "homepage_url": "https://github.com/tarter-ian/offset-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://myactivity.google.com/*",
    "https://www.doordash.com/*",
    "https://www.ubereats.com/*",
    "https://www.amazon.com/*",
    "https://riders.uber.com/*",
    "https://www.netflix.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.itsian123.workers.dev/*",
        "https://offset-website-kappa.vercel.app/*",
        "https://offset-website-git-step-1-estimate-tarter1.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
