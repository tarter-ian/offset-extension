{
  "manifest_version": 3,
  "name": "Offset: measure my usage",
  "version": "0.16.0",
  "description": "Counts how much you use AI, video, food delivery, shopping and ride services you are signed in to, so Offset can work out your footprint. Only counts and dates are shared.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://myactivity.google.com/*",
    "https://www.doordash.com/*",
    "https://www.ubereats.com/*",
    "https://www.amazon.com/*",
    "https://riders.uber.com/*",
    "https://www.netflix.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.itsian123.workers.dev/*",
        "https://offset-website-kappa.vercel.app/*",
        "https://offset-website-git-step-1-estimate-tarter1.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
